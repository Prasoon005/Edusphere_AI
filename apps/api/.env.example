NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://edusphere:edusphere_dev_password@localhost:5432/edusphere_ai?schema=public"

JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

STORAGE_DRIVER=local
# When STORAGE_DRIVER=s3
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
